<?xml version="1.0" encoding="UTF-8"?>
<appian-component-plugin name="Final Browser Agent" key="com.final.browseragent">
  <plugin-info>
    <description>Returns user agent string</description>
    <vendor name="Final Test" url="https://www.example.com" />
    <support supported="false" email="support@example.com" url="https://community.appian.com" />
    <version>1.0.0</version>
  </plugin-info>

  <component rule-name="finalAgent" version="1.0.0">
    <sdk-version>2.0.0</sdk-version>
    <html-entry-point>index.html</html-entry-point>
    <supported-user-agents>chrome firefox ie11 edge safari mobile</supported-user-agents>
    <parameter name="userAgent" type="Text" />
  </component>
</appian-component-plugin>