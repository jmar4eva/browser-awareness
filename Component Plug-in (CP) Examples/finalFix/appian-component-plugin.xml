<?xml version="1.0" encoding="UTF-8"?>
<appian-component-plugin name="Forced Fix Plugin" key="com.forcing.fix" xmlns="http://www.appian.com/ae/types/2009">
  <plugin-info>
    <description>Reads user agent</description>
    <vendor name="Fix" url="https://www.example.com" />
    <support supported="false" email="support@example.com" url="https://community.appian.com" />
    <version>1.0.0</version>
  </plugin-info>

  <component rule-name="forceRead" version="1.0.0">
    <sdk-version>2.0.0</sdk-version>
    <html-entry-point>index.html</html-entry-point>
    <supported-user-agents>chrome firefox ie11 edge safari mobile</supported-user-agents>
    <parameter name="userAgent" type="Text" />
  </component>
</appian-component-plugin>